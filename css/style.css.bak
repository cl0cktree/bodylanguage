#body-sec-wrap2 .body-art-wrap .body-sec-scroll .sec-scroll-mainlogowrap .scroll-mainlogo-row .scroll-login-loginbtn{display:table-cell; width:70px;height:90px;background:#959595;border:3px solid #a5a5a5;border-radius:5px;margin-left:0px;margin-bottom:5px;font-size:16px;text-align:center;line-height:90px;font-size:15px;cursor:pointer;transition:all 0.2s;float:right;}
#body-sec-wrap2 .body-art-wrap .body-sec-scroll .scroll-login-getinbtn{width:100%;height:40px;border:3px solid #a5a5a5;border-radius:5px;margin:10px auto;padding-left:7px;font-size:16px;text-align:center;line-height:40px;cursor:pointer;transition:all 0.2s;}

