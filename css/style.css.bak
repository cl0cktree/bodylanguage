#body-sec-wrap2 .body-art-wrap .body-sec-scroll #sec-scroll-mainlogo{width:100%;max-width:400px; margin:0 auto;background:#fff;margin-top:120px; margin-bottom:60px; text-align:center;}
#body-sec-wrap2 .body-art-wrap .body-sec-scroll #sec-scroll-mainlogo img{width:100%;margin-left:10px;}
#body-sec-wrap2 .body-art-wrap .body-sec-scroll .sec-scroll-mainlogowrap{display:table;width:100%;padding-bottom:0px;padding-top:0;}
#body-sec-wrap2 .body-art-wrap .body-sec-scroll .sec-scroll-mainlogowrap .scroll-mainlogo-row{display:table-row;width:100%;}
#body-sec-wrap2 .body-art-wrap .body-sec-scroll .sec-scroll-mainlogowrap .scroll-mainlogo-row #sec-scroll-login{display:table-cell;width:100%;}
