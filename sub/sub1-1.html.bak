<!DOCTYPE HTML5>
<html>
	<head>
		<title> Body-language </title>
		<meta charset="utf-8">
		<link rel="stylesheet" href="../css/style.css" />
		<script type="text/javascript" src="../js/jquery-1.7.2.min.js"></script>
		<script type="text/javascript" src="../js/move.js"></script>
	</head>

	<body>
		<div id="body-sec-wrap3" class="body-sec-wrap">
			<div id="body-sec-toptitle1" class="body-sec-toptitle">
				<div id="sec-toptitle-backbtn1" class="sec-toptitle-backbtn">
					< 이전
					<a href="sub1.html"><div id="toptitle-backbtn-filter1" class="toptitle-backbtn-filter"></div></a>
				</div>
				<div id="sec-toptitle-logo1" class="sec-toptitle-logo">
					<img src="../images/logo-size3.jpg" alt="">
				</div>
			</div>
			<div id="body-art-wrap1" class="body-art-wrap">
				<div id="body-sec-scroll1" class="body-sec-scroll">
					<div id="sec-scroll-table1" class="sec-scroll-table">
						<div id="scroll-table-title1" class="scroll-table-title">
							회원가입
						</div>
						<div id="scroll-table-boxwrap1" class="scroll-table-boxwrap">
							<form method="post" action="">
								<div id="table-boxwrap-col1" class="table-boxwrap-col">
									<div id="boxwrap-col-th1" class="boxwrap-col-th">
										아이디
									</div>
									<div id="boxwrap-col-td1" class="boxwrap-col-td">
										<input type="text" name="" id="col-td-textbox1" class="col-td-textbox" onfocus="if(this.value=='아이디 입력'){this.value='';style='color:#000;'}" onclick="if(this.value=='아이디 입력'){this.value='';style='color:#000;'}" value="아이디 입력" maxlength="30" placeholder="아이디 입력">
									</div>
								</div>
								<div id="table-boxwrap-col2" class="table-boxwrap-col">
									<div id="boxwrap-col-th2" class="boxwrap-col-th">
										비밀번호
									</div>
									<div id="boxwrap-col-td2" class="boxwrap-col-td">
										<input type="text" name="" id="col-td-textbox1" class="col-td-textbox" onfocus="if(this.value=='비밀번호 입력'){this.value='';style='color:#000';type='password'}" onclick="if(this.value=='비밀번호 입력'){this.value='';style='color:#000';type='password'}" value="비밀번호 입력" maxlength="10" placeholder="비밀번호 입력">
									</div>
								</div>
								<div id="table-boxwrap-col3" class="table-boxwrap-col">
									<div id="boxwrap-col-th3" class="boxwrap-col-th">
										비밀번호
										확인
									</div>
									<div id="boxwrap-col-td3" class="boxwrap-col-td">
										<input type="text" name="" id="col-td-textbox1" class="col-td-textbox" onfocus="if(this.value=='비밀번호 입력'){this.value='';style='color:#000';type='password'}" onclick="if(this.value=='비밀번호 입력'){this.value='';style='color:#000';type='password'}" value="비밀번호 입력" maxlength="10" placeholder="비밀번호 입력">
									</div>
								</div>
								<div id="table-boxwrap-col4" class="table-boxwrap-col">
									<div id="boxwrap-col-th4" class="boxwrap-col-th">
										연락처
									</div>
									<div id="boxwrap-col-td4" class="boxwrap-col-td">
										<input type="text" name="" id="col-td-textbox1" class="col-td-textbox" onfocus="if(this.value=='연락처 입력'){this.value='';style='color:#000;'}" onclick="if(this.value=='연락처 입력'){this.value='';style='color:#000;'}" value="연락처 입력" maxlength="13" placeholder="연락처 입력">
									</div>
								</div>
								<div id="table-boxwrap-col5" class="table-boxwrap-col">
									<div id="boxwrap-col-th5" class="boxwrap-col-th">
										나이
									</div>
									<div id="boxwrap-col-td5" class="boxwrap-col-td">
										<select name="" class="col-td-selectbox" onfocus="style='color:#000;'">
											<option value="" selected >- - - -</option>
											<option value="">1957</option>
											<option value="">1958</option>
											<option value="">1959</option>
											<option value="">1960</option>
											<option value="">1961</option>
											<option value="">1962</option>
											<option value="">1963</option>
											<option value="">1964</option>
											<option value="">1965</option>
											<option value="">1966</option>
											<option value="">1967</option>
											<option value="">1968</option>
											<option value="">1969</option>
											<option value="">1970</option>
											<option value="">1971</option>
											<option value="">1972</option>
											<option value="">1973</option>
											<option value="">1974</option>
											<option value="">1975</option>
											<option value="">1976</option>
											<option value="">1977</option>
											<option value="">1978</option>
											<option value="">1979</option>
											<option value="">1980</option>
											<option value="">1981</option>
											<option value="">1982</option>
											<option value="">1983</option>
											<option value="">1984</option>
											<option value="">1985</option>
											<option value="">1986</option>
											<option value="">1987</option>
											<option value="">1988</option>
											<option value="">1989</option>
											<option value="">1990</option>
											<option value="">1991</option>
											<option value="">1992</option>
											<option value="">1993</option>
											<option value="">1994</option>
											<option value="">1995</option>
											<option value="">1996</option>
											<option value="">1997</option>
										</select>
									</div>
								</div>
								<div id="table-boxwrap-col6" class="table-boxwrap-col">
									<div id="boxwrap-col-th6" class="boxwrap-col-th">
										이름
									</div>
									<div id="boxwrap-col-td6" class="boxwrap-col-td">
										<input type="text" name="" id="col-td-textbox1" class="col-td-textbox" onfocus="if(this.value=='이름 입력'){this.value='';style='color:#000;'}"value="이름 입력" maxlength="30" placeholder="이름 입력">
									</div>
								</div>
								<div id="table-boxwrap-col7" class="table-boxwrap-col">
									<div id="boxwrap-col-th7" class="boxwrap-col-th">
										이메일
									</div>
									<div id="boxwrap-col-td7" class="boxwrap-col-td">
										<input type="text" name="" id="col-td-textbox1" class="col-td-textbox" onfocus="if(this.value=='이메일 입력'){this.value='';style='color:#000;'}"value="이메일 입력" maxlength="30" placeholder="이메일 입력">
									</div>
								</div>
							</form>
						</div>
						<div id="table-middle-word1" class="table-middle-word">
							※ 사용자기기정보 및 IP는 맞춤일당 시스템에 기록되고있으며, 허위 정보 또는 타인 정보 도용 등으로 배정요청 할 경우에는 관련법에 따라 법적 제재를 받을 수 있습니다.
						</div>
						<div id="table-checkbox-wrap1" class="table-checkbox-wrap">
							<div id="table-checkbox-con1" class="table-checkbox-con">
								<input type="checkbox" name="" id="checkbox-con-check1" class="checkbox-con-check"> 
								<div id="checkbox-con-word1" class="checkbox-con-word">
									회원이용약관에 동의합니다.
								</div>
								<div id="checkbox-con-link1" class="checkbox-con-link">
									<a href="" onclick="alert('회원이용약관 내용이이 없습니다.')">내용보기 ></a>
								</div>
							</div>
							<div id="table-checkbox-con2" class="table-checkbox-con">
								<input type="checkbox" name="" id="checkbox-con-check1" class="checkbox-con-check"> 
								<div id="checkbox-con-word2" class="checkbox-con-word">
									개인정보취급방침에 동의합니다.
								</div>
								<div id="checkbox-con-link2" class="checkbox-con-link">
									<a href="" onclick="alert('개인정보취급방침 내용이 없습니다.')">내용보기 ></a>
								</div>
							</div>
							<div id="table-checkbox-con3" class="table-checkbox-con">
								<input type="checkbox" name="" id="checkbox-con-check1" class="checkbox-con-check"> 
								<div id="checkbox-con-word3" class="checkbox-con-word">
									위치확인서비스에 동의합니다.
								</div>
								<div id="checkbox-con-link3" class="checkbox-con-link">
									<a href="" onclick="alert('위치확인서비스 내용이 없습니다.')">내용보기 ></a>
								</div>
							</div>
						</div>
						<div id="table-getin-btnwrap1" class="table-getin-btnwrap">
							<div id="table-getin-btn1" class="table-getin-btn">
								회원가입
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</body>
</html>
