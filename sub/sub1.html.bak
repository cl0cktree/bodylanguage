<!DOCTYPE HTML5>
<html>
	<head>
		<title> Body-language </title>
		<meta charset="utf-8">
		<link rel="stylesheet" href="../css/style.css" />
		<script type="text/javascript" src="../js/jquery-1.7.2.min.js"></script>
		<script type="text/javascript" src="../js/move.js"></script>
	</head>

	<body>
		<div id="body-sec-wrap2" class="body-sec-wrap">
			<div id="body-sec-toptitle1" class="body-sec-toptitle1">
				
			</div>
			<div id="body-art-wrap1" class="body-art-wrap">
				<div id="body-sec-scroll1" class="body-sec-scroll">
					<div id="sec-scroll-mainlogo">
						<img src="../images/mainlogo.jpg" alt="">
					</div>
					
					<div id="sec-scroll-mainlogowrap" class="sec-scroll-mainlogowrap">
						<div id="scroll-mainlogo-row" class="scroll-mainlogo-row">
							<div id="sec-scroll-login">
								<div id="scroll-login-idwrap" class="scroll-login-textboxwrap">
									<input type="text" name="" id="scroll-login-id" class="scroll-login-textbox" onclick="if(this.value=='아이디'){this.value=''}" onfocus="" value="아이디" maxlength="20" placeholder="아이디">
								</div>
								<div id="scroll-login-pwwrap" class="scroll-login-textboxwrap">
									<input type="text" name="" id="scroll-login-pw" class="scroll-login-textbox" onclick="if(this.value=='패스워드'){this.value='';type='password'}" onfocus="" value="패스워드" maxlength="20" placeholder="패스워드">
								</div>
								
							</div>
							<div id="scroll-login-loginbtn1" class="scroll-login-loginbtn">
								로그인
							</div>
						</div>
					</div>
					<div id="scroll-login-getinbtn1" class="scroll-login-getinbtn">
						회원가입
					</div>
				</div>
			</div>
		</div>
	</body>
</html>
