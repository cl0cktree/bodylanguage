			function startDay(){
				var sd = document.getElementById("start-day-selectbox1");
				var sdtb = document.getElementById("con-start-day-textbox1");
				sdtb.value = sd.options[sd.selectedIndex].text.substring(5,10);
			    sdpass = sdtb.value.substring(3,5)
			}

			function endDay(){
				var ed = document.getElementById("end-day-selectbox1");
				var edtb = document.getElementById("con-end-day-textbox1");
				edtb.value = ed.options[ed.selectedIndex].text.substring(5,10);
			}
			
			function startTime(){
				var st = document.getElementById("start-time-selectbox1");
				var sttb = document.getElementById("con-start-time-textbox2");
				sttb.value = st.options[st.selectedIndex].text.substring(0,3);
				stpass = sttb.value.substring(0,3)
			}
			
			function endTime(){
				var et = document.getElementById("end-time-selectbox1");
				var ettb = document.getElementById("con-end-time-textbox2");
				ettb.value = et.options[et.selectedIndex].text.substring(0,3);
			}
			
		//-->
		</script>
	</body>
</html>
